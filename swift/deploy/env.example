# Discord Agent Bridge — deploy env.
# install scripts copy this to ~/.dab/env (chmod 0600 on Unix) when it is missing.
# Secrets live ONLY here. NEVER in the launchd plist / systemd unit / scheduled task.

# Required: Discord gateway bot token (DISCORD_TOKEN also accepted).
DISCORD_BOT_TOKEN=

# Optional: Claude/Codex/Grok session working directory (default: home).
DAB_CWD=

# Optional: permission mode. bypassPermissions (default) skips the tool-permission
# UI — trusted envs only. Use "default" when a permission UI is available.
DAB_PERM_MODE=

# Optional: seconds to wait for a turn result before giving up (default 120).
DAB_TURN_TIMEOUT_SEC=

# Optional: dev guild id for instant per-guild slash registration (else global, ~1h).
DAB_DEV_GUILD_ID=

# PATH hint: service managers start children with a minimal PATH. run.sh (Unix)
# prepends Homebrew/linuxbrew + ~/.local/bin + ~/.grok/bin + ~/.cargo/bin.
# If node / codex / grok live elsewhere (e.g. nvm, a custom npm prefix), add that
# bin dir to run.sh / run.cmd PATH export or export PATH here.

# Optional: Redmine API-key encryption secret. Auto-generated into ~/.dab/env on first boot if missing.
# DAB_REDMINE_KEY_SECRET=

